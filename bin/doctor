#!/usr/bin/env python3
"""doctor — prueft jedes ausfuehrbare Skill-Binary und schreibt STATUS.md.

 Wahrheit statt Annahme: ein Skill gilt nur als gruen, wenn das Binary antwortet.
"""
import json
import os
import shutil
import subprocess
import time

ROOT = os.path.join(os.path.expanduser("~"), "ctf-skills")
ENTRY = {
    "slither": "slither", "crytic-compile": "crytic-compile", "solc-select": "solc-select",
    "mythril": "myth", "scribble": "scribble", "surya": "surya", "solhint": "solhint",
    "echidna": "echidna", "medusa": "medusa", "cryo": "cryo", "diffusc": "diffusc",
    "rbuilder": "rbuilder", "evm-cfg-builder": "evm-cfg-builder", "pyevmasm": "evmasm",
    "mev-inspect-py": "inspect-block", "etheno": "etheno", "daedaluzz": "daedaluzz",
    "fuzz-utils": "fuzz-utils",
    "forge": "forge", "cast": "cast", "anvil": "anvil", "uv": "uv",
}
PROBE = ["--version", "version", "--help", "-h"]


def probe(binary):
    if not shutil.which(binary):
        return False, "nicht im PATH"
    for flag in PROBE:
        try:
            r = subprocess.run([binary, flag], capture_output=True, text=True, timeout=25)
        except (subprocess.TimeoutExpired, OSError) as exc:
            return False, f"{flag}: {type(exc).__name__}"
        out = (r.stdout or r.stderr).strip().splitlines()
        if r.returncode == 0 and out:
            return True, out[0][:90]
    return False, "antwortet auf keinen Probe-Flag"


def main():
    skills = json.load(open(os.path.join(ROOT, "manifest.json")))["skills"]
    lines = ["# STATUS", "", f"Stand: {time.strftime('%Y-%m-%d %H:%M')}", "",
             "Verifikationsnachweis: siehe `VERIFICATION.md` (echte Laeufe, keine --help-Tests).", "",
             "## Ausfuehrbare Skills", "", "| Skill | Binary | Status | Antwort |", "|---|---|---|---|"]
    ok = bad = 0
    for e in sorted(skills, key=lambda x: x["slug"]):
        binary = ENTRY.get(e["slug"])
        if not binary:
            continue
        good, msg = probe(binary)
        if good:
            state, ok = "OK", ok + 1
        elif "nicht im PATH" in msg:
            state, bad = "**FAIL**", bad + 1
        else:
            state, ok = "kein CLI-Flag (Bibliothek)", ok + 1
            msg += " — Binary vorhanden"
        lines.append(f"| `{e['slug']}` | `{binary}` | {state} | {msg} |")
    ref = [e for e in skills if e["kind"] in ("knowledge", "knowledge-archived", "corpus", "source", "docker")]
    lines += ["", f"**{ok} ausfuehrbar, {bad} fehlgeschlagen, {len(ref)} Referenz-Skills**", "",
              "## Referenz ohne Binary (bewusst)", ""]
    for e in sorted(ref, key=lambda x: x["slug"]):
        lines.append(f"- `{e['slug']}` ({e['kind']}, {e['layer']}) — {e['install']}")
    fetched = sum(1 for e in skills if e["fetched"])
    lines += ["", f"## Bezug", "", f"- {fetched}/{len(skills)} Skills mit Quellstand in `vendor/`"]
    missing = [e["slug"] for e in skills if not e["fetched"]]
    if missing:
        lines.append("- **fehlend:** " + ", ".join(missing))
    open(os.path.join(ROOT, "STATUS.md"), "w").write("\n".join(lines) + "\n")
    print(f"ok={ok} fail={bad} reference={len(ref)} fetched={fetched}/{len(skills)}")
    for e in skills:
        b = ENTRY.get(e["slug"])
        if b and not shutil.which(b):
            print(f"  FAIL {e['slug']} -> {b}")


if __name__ == "__main__":
    main()
